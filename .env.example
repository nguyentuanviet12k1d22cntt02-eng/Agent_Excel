# Mẫu cấu hình. Sao chép thành apps/backend/.env (hoặc spikes/<thu-muc-spike>/.env) rồi điền giá trị thật.
# KHÔNG commit file .env. Xem docs/quy-uoc/quy-tac-code.md mục 5.

# ----- Mô hình ngôn ngữ (chốt ở T0.4) -----
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# ----- Mô hình embedding cho RAG (chốt ở T0.4) -----
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# ----- Cơ sở dữ liệu (chốt ở T3.6) -----
DATABASE_URL=
