# Mẫu cấu hình. Sao chép thành apps/backend/.env (hoặc spikes/<thu-muc-spike>/.env) rồi điền giá trị thật.
# KHÔNG commit file .env. Xem docs/quy-uoc/quy-tac-code.md mục 5.

# ----- Mô hình ngôn ngữ (đã chốt ở T0.4: Inception Labs, API tương thích OpenAI) -----
LLM_PROVIDER=inceptionlabs
LLM_BASE_URL=https://api.inceptionlabs.ai/v1
LLM_MODEL=mercury-3
LLM_API_KEY=

# ----- Mô hình embedding cho RAG (chốt ở T5.4; Inception Labs không có embedding) -----
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# ----- Cơ sở dữ liệu (T3.6, T5.1) -----
# Bỏ trống: SQLite trong apps/backend/storage/dev.db (phát triển).
# Triển khai: postgresql+psycopg://<người dùng>:<mật khẩu>@<máy chủ>:5432/<tên CSDL>
DATABASE_URL=
# Thư mục lưu CSDL SQLite và file tải lên. Bỏ trống: apps/backend/storage/
STORAGE_DIR=

# ----- Xác thực (T5.2) -----
# Chuỗi ngẫu nhiên dài, ví dụ: .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
# Bỏ trống thì mỗi lần khởi động dùng khóa tạm, đăng nhập lại sau khi khởi động lại.
JWT_SECRET=
