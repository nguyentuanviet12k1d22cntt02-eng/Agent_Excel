# ----- Mô hình embedding cho RAG (chốt ở T0.4) -----
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# ----- Cơ sở dữ liệu (chốt ở T3.6) -----
